# OpenAI key used by the server only (never sent to the browser).
OPENAI_API_KEY=
# Optional: override the model. Must support tool calling and JSON schema output.
OPENAI_MODEL=gpt-5.4-mini

# Turso (hosted SQLite). For local development you may use TURSO_DATABASE_URL=file:local.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional bearer token required by /api/mcp when set.
MCP_API_KEY=
# Optional: absolute URL of the MCP endpoint the Clerk calls. Defaults to <this site>/api/mcp.
MCP_SERVER_URL=

# Enables fast-forward clock, member switcher and reset.
DEMO_MODE=true

# Budget guards for AI calls.
AI_DAILY_CALL_CAP=300
AI_SESSION_DAILY_CAP=40
